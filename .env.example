# ------------------------------------------------------------------
# RetailOS Morocco — environment variables
# Copy to .env and fill in. Never commit real secrets.
# ------------------------------------------------------------------

# Database
#   Development (zero setup):  file:./dev.db          (prisma/schema.prisma provider = "sqlite")
#   Production:                postgresql://user:password@host:5432/retailos?schema=public
#   Switch provider with: node scripts/set-db-provider.mjs postgresql
DATABASE_URL="file:./dev.db"

# Authentication (required). Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Brute-force protection: login attempts per 15 minutes per IP+email (default 10)
LOGIN_RATE_LIMIT=10

# Redis (optional). Shares rate limiting across app instances; falls back to in-memory if unset/unreachable.
REDIS_URL=""

# Daily maintenance job: POST /api/cron/daily with "Authorization: Bearer $CRON_SECRET"
CRON_SECRET="change-me"

# AI assistant (optional). Without a key, answers are computed deterministically from your data.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# E-mail via SMTP (optional). Used for password reset links and alert e-mails.
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="RetailOS Morocco <noreply@example.com>"

# Docker Compose only
POSTGRES_DB=retailos
POSTGRES_USER=retailos
POSTGRES_PASSWORD="change-me"
# Public hostname for Caddy's automatic HTTPS (Let's Encrypt). Use "localhost" for a self-signed local test.
DOMAIN=localhost

# Debugging: log every SQL query in development
PRISMA_LOG_QUERIES=false
