# Caddy automatically provisions and renews Let's Encrypt certificates for DOMAIN.
# Set DOMAIN=shop.example.com (public DNS must point at this host, ports 80/443 open).
# For local testing without a domain, set DOMAIN=localhost (Caddy issues a self-signed cert).
{$DOMAIN:localhost} {
	encode zstd gzip

	# Security headers are also set by Next.js; these cover Caddy-served error pages.
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Real-IP {remote_host}
	}
}
